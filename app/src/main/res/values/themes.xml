<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window theme shown before Compose draws; the Compose theme takes over afterwards.
         AppCompat parent so per-app language switching works on every API level. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
